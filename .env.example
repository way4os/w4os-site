# The dev server of dev/deploy.sh: an ssh host (with sudo for apt-get), and the address of the site there
DEPLOY_HOST=
DEPLOY_URL=
# The family and the channels of the packages: charm (stable, unstable) for the releases, charm-tests (dev) for the builds between
APT_REPO_DIST="charm"
APT_REPO_TESTS_DIST="charm-tests"
APT_REPO_TESTS_COMPONENT="dev"
