#!/usr/bin/env bash
# w4os-site: set up the light website of an OpenSimulator grid.
#
#   w4os-site setup [--api <engine API>] [--url <helpers>] [--key <key>] [--grid <nick>] [--title <title>] [--no-mail | --mail]
#       connect the site to the engine API of a grid, at its own address (on the machine of the grid, the one opensim web GRID
#       api serves, proposed), and to its helpers for the blocks (asked when not given); --no-mail on a test site: the engine mails
#       nothing, the confirmation links are shown on the page
#   w4os-site status
#       what the site is connected to, and whether the API answers
#   w4os-site web apache|caddy|nginx [--host <name>] [--port <port>] [--install]
#       the configuration of a web server for the site (printed; installed and enabled with --install, Apache only), at the
#       host and the port of the address of the site when not given (localhost on a new site)
#   w4os-site --version
#       the version of the site

PGM=w4os-site
COMMANDOPTS=setup,status,web
# Sourced before the options of the shell: bash-tools 1.0.9 stops under set -e when gnu-getopt is not where Homebrew puts it
source "$(command -v bash-helpers)"
set -eo pipefail

SHARE=${W4OS_SITE_SHARE:-/usr/share/w4os-site}
# The site, a standard Grav site the web user owns (bin/w4os-site-tree makes it)
ROOT=${W4OS_SITE_ROOT:-/var/lib/w4os/www}
CONFIG="$ROOT/user/config"
KEY_FILE="$ROOT/user/data/w4os/api.json"
OWNER=${W4OS_SITE_OWNER:-}
GROUP=${W4OS_SITE_GROUP:-$OWNER}

# web_account: the account and group of the web server ("user group"), as the engine of the machine resolves them (WebUser and
# WebGroup of w4os.conf, its profile over [Defaults]), read with the engine the site's w4os plugin carries; www-data without them
web_account() {
    local vendor
    for vendor in "$ROOT/user/plugins/w4os/vendor" "${SEED:-$ROOT}/user/plugins/w4os/vendor"; do
        [ -f "$vendor/autoload.php" ] || continue
        ${W4OS_SITE_PHP:-php} -r 'require $argv[1]; $layout = W4OS\Engine\Config\Layout::load(); echo $layout->webUser(), " ", $layout->webGroup(), PHP_EOL;' \
            "$vendor/autoload.php" 2>/dev/null && return
    done
    echo "www-data www-data"
}

# owner: OWNER and GROUP set from the engine's settings, unless the environment gives them
owner() {
    [ -n "$OWNER" ] || read -r OWNER GROUP < <(web_account) || true
}

# engine_api_urls [GRID]: "nick address" of the engine API of each grid of this machine (of GRID alone when given), as opensim web
# GRID api serves it (its port is the grid's): read with the engine installed here, else with the one the site's w4os plugin
# carries; nothing without a grid here, nor for a grid whose API has no port yet
engine_api_urls() {
    local code engine=${W4OS_SITE_ENGINE:-/usr/share/w4os-engine}
    # shellcheck disable=SC2016 # PHP's own variables
    code='foreach (array_slice($argv, 2) as $autoload) { require $autoload; }
        $environment = W4OS\Engine\Runtime\Environment::system(W4OS\Engine\Config\Layout::load());
        $grids = $argv[1] !== "" ? array_filter([W4OS\Engine\Models\Grid::find($environment, $argv[1])]) : W4OS\Engine\Models\Grid::all($environment);
        foreach ($grids as $grid) {
            $port = method_exists($grid, "knownApiPort") ? $grid->knownApiPort() : null;
            $port === null || print($grid->nick() . " http://127.0.0.1:$port/api" . PHP_EOL);
        }'
    if [ -f "$engine/vendor/autoload.php" ]; then
        ${W4OS_SITE_PHP:-php} -r "$code" "${1:-}" "$engine/vendor/autoload.php" 2>/dev/null && return
    fi
    [ ! -f "$ROOT/user/plugins/w4os/vendor/autoload.php" ] ||
        ${W4OS_SITE_PHP:-php} -r "$code" "${1:-}" "$ROOT/vendor/autoload.php" "$ROOT/user/plugins/w4os/vendor/autoload.php" 2>/dev/null || true
}

# The value of a top-level key of a YAML file, quotes removed
yaml_get() {
    [ -f "$1" ] && sed -n "s/^$2:[[:space:]]*//p" "$1" | head -1 | sed "s/^'\(.*\)'\$/\1/; s/^\"\(.*\)\"\$/\1/" || true
}

# Set a top-level key of a YAML file to a quoted string (or as it is, with --raw: true, false, a number)
yaml_set() {
    local raw=
    [ "$1" != --raw ] || { raw=1; shift; }
    local file=$1 key=$2 value=${3//\'/\'\'}
    [ -z "$raw" ] || value=$3
    mkdir -p "$(dirname "$file")"
    touch "$file"
    if grep -q "^$key:" "$file"; then
        local escaped=${value//\\/\\\\}
        escaped=${escaped//&/\\&}
        escaped=${escaped//|/\\|}
        [ -n "$raw" ] || escaped="'$escaped'"
        sed -i.bak "s|^$key:.*|$key: $escaped|" "$file" && rm -f "$file.bak"
    else
        [ -n "$raw" ] || value="'$value'"
        echo "$key: $value" >>"$file"
    fi
}

api_key() {
    [ -f "$KEY_FILE" ] && sed -n 's/.*"api_key"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$KEY_FILE" || true
}

# GET a path of the engine API (its own address) with the key of the site; the body, or nothing
api_get() {
    local api=$1 key=$2 path=$3
    curl -fsS --max-time 15 -H "Authorization: Bearer $key" -H 'Accept: application/vnd.api+json' "${api%/}$path"
}

ask() {
    local prompt=$1 default=${2:-} answer
    [ -t 0 ] || { echo "$default"; return; }
    read -r -p "$prompt${default:+ [$default]}: " answer
    echo "${answer:-$default}"
}

setup() {
    local api= url= key= grid= title= mail=
    while [ $# -gt 0 ]; do
        case $1 in
        --no-mail) mail=false; shift ;;
        --mail) mail=true; shift ;;
        --api) api=$2; shift 2 ;;
        --url) url=$2; shift 2 ;;
        --key) key=$2; shift 2 ;;
        --grid) grid=$2; shift 2 ;;
        --title) title=$2; shift 2 ;;
        *) die "unknown option $1" ;;
        esac
    done
    [ -d "$CONFIG" ] || die "$CONFIG is missing: is the package installed?"
    # The engine API at its own address, never under the helpers: on the machine of the grid, its local listener
    # proposed: the one the site has, else the one of the grid of this machine (of --grid, or the only one), as the engine gives it
    local suggested known=
    suggested=$(yaml_get "$CONFIG/plugins/w4os.yaml" api_url)
    if [ -z "$suggested" ] && [ -z "$api" ]; then
        known=$(engine_api_urls "$grid")
        [ "$(grep -c . <<<"$known")" != 1 ] || suggested=${known#* }
    fi
    local mine='on the machine of the grid, the one opensim web GRID api serves'
    [ -z "$known" ] || mine="on this machine: $(tr '\n' ',' <<<"$known" | sed 's/,$//; s/,/, /g')"
    api=${api:-$(ask "Address of the engine API (https://grid.example.org/api, or $mine)" "$suggested")}
    [ -n "$api" ] || die "the address of the engine API is needed (--api)"
    api=${api%/}
    url=${url:-$(ask 'Address of the helpers of the grid (https://grid.example.org/helpers)' "$(yaml_get "$CONFIG/plugins/w4os.yaml" url)")}
    [ -n "$url" ] || die "the address of the helpers is needed"
    url=${url%/}
    key=${key:-$(api_key)}
    # A grid on this machine makes the key itself
    if [ -z "$key" ] && command -v opensim >/dev/null; then
        key=$(opensim api-key create "w4os-site $(hostname)" 2>/dev/null | grep -o 'osk_[A-Za-z0-9_-]*' | head -1 || true)
        [ -z "$key" ] || log "made the API key 'w4os-site $(hostname)' of this machine"
    fi
    [ -n "$key" ] || key=$(ask 'API key of the site (opensim api-key create <label>, on the machine of the grid)')
    [ -n "$key" ] || die "the API key is needed"

    local info
    info=$(api_get "$api" "$key" /info) || die "the engine API does not answer at $api with this key"
    local name
    name=$(printf '%s' "$info" | sed -n 's/.*"gridname":"\([^"]*\)".*/\1/p')

    yaml_set "$CONFIG/plugins/w4os.yaml" engine remote
    yaml_set "$CONFIG/plugins/w4os.yaml" api_url "$api"
    yaml_set "$CONFIG/plugins/w4os.yaml" url "$url"
    [ -z "$grid" ] || yaml_set "$CONFIG/plugins/w4os.yaml" grid "$grid"
    [ -z "$mail" ] || yaml_set --raw "$CONFIG/plugins/w4os.yaml" send_mail "$mail"
    title=${title:-$(ask 'Title of the site' "${name:-$(yaml_get "$CONFIG/site.yaml" title)}")}
    [ -z "$title" ] || yaml_set "$CONFIG/site.yaml" title "$title"
    mkdir -p "$(dirname "$KEY_FILE")"
    printf '{"api_key":"%s"}\n' "$key" >"$KEY_FILE"
    chmod 640 "$KEY_FILE"
    owner
    chown -R "$OWNER:$GROUP" "$CONFIG" "$ROOT/user/data" 2>/dev/null || true
    rm -rf "${W4OS_SITE_CACHE:-$ROOT/cache}"/* 2>/dev/null || true
    success "connected to ${name:-the grid} ($api)"
}

status() {
    local api url key
    api=$(yaml_get "$CONFIG/plugins/w4os.yaml" api_url)
    url=$(yaml_get "$CONFIG/plugins/w4os.yaml" url)
    key=$(api_key)
    echo "site:    $(yaml_get "$CONFIG/site.yaml" title)"
    echo "api:     ${api:-not set}"
    echo "helpers: ${url:-not set}"
    echo "key:     $([ -n "$key" ] && echo set || echo 'not set')"
    [ "$(yaml_get "$CONFIG/plugins/w4os.yaml" send_mail)" != false ] || echo "mail:    off (test site: the links are shown on the page)"
    [ -n "$api" ] && [ -n "$key" ] || die "not connected: w4os-site setup"
    api_get "$api" "$key" /info >/dev/null && echo "api:     answers" || die "api:     does not answer"
    curl -fsS --max-time 15 -o /dev/null "$url/blocks/grid-info" && echo "blocks:  answer" || warning "blocks:  do not answer"
}

# The socket of PHP-FPM, as its pool says it (listen, in /etc/php/<version>/fpm/pool.d, the version of the site's PHP first), whether
# PHP-FPM runs yet or not; else a socket that is there; nothing without PHP-FPM, or with a pool on a TCP port
php_socket() {
    local etc=${W4OS_SITE_PHP_ETC:-/etc/php} version conf listen socket
    version=$(php -r 'echo PHP_MAJOR_VERSION, ".", PHP_MINOR_VERSION;' 2>/dev/null || true)
    # shellcheck disable=SC2012 # the newest version first; their names have no space
    for conf in ${version:+"$etc/$version"/fpm/pool.d/*.conf} $(ls -r "$etc"/*/fpm/pool.d/*.conf 2>/dev/null); do
        [ -f "$conf" ] || continue
        listen=$(sed -n 's/^[[:space:]]*listen[[:space:]]*=[[:space:]]*\(\/[^[:space:];]*\).*/\1/p' "$conf" | head -1)
        [ -n "$listen" ] && echo "$listen" && return
    done
    for socket in /run/php/php-fpm.sock /run/php/php*-fpm.sock /run/php/php*-fpm-*default.sock; do
        [ -S "$socket" ] && echo "$socket" && return
    done
    return 0
}

# check_site BASE PORT HOST SOCKET: whether the site answers through PHP on this machine (its page with its title, never PHP's
# source), said either way: what is missing when it does not, with a non-zero status
check_site() {
    local base=$1 port=$2 host=$3 socket=$4 page title
    title=$(yaml_get "$CONFIG/site.yaml" title)
    title=${title//&/&amp;}
    title=${title//\'/&#039;}
    page=$(curl -s --max-time 15 -H "Host: $host" "http://127.0.0.1:$port/" 2>/dev/null || true)
    if grep -q '<title>' <<<"$page" && ! grep -q '<?php' <<<"$page" && { [ -z "$title" ] || grep -qF -- "$title" <<<"$page"; }; then
        success "the site answers at $base/"
        return 0
    elif [ -n "$socket" ] && [ ! -S "$socket" ]; then
        # Its service by the name of its socket (php8.2-fpm), as Debian names both
        local service
        service=$(basename "$socket" .sock)
        [[ $service == php*-fpm ]] || service=php-fpm
        warning "PHP does not run: PHP-FPM is not running ($socket is missing): systemctl start $service, the site is at $base/"
    elif [ -z "$page" ]; then
        warning "Apache does not answer on port $port yet: start it (systemctl start apache2), the site is at $base/"
    elif grep -q '<?php' <<<"$page"; then
        warning "Apache shows the PHP source of the site, it runs no PHP for it: install php-fpm, then w4os-site web apache --install again"
    else
        warning "the site does not answer as it should at $base/: see /var/log/apache2/w4os-site-error.log"
    fi
    return 1
}

web() {
    local server=${1:-} host= port= install=
    shift || true
    while [ $# -gt 0 ]; do
        case $1 in
        --host) host=$2; shift 2 ;;
        --port) port=$2; shift 2 ;;
        --install) install=1; shift ;;
        *) die "unknown option $1" ;;
        esac
    done
    # The host and the port of the address of the site (custom_base_url) when not given, never the name of the machine
    local url scheme=
    url=$(yaml_get "$CONFIG/system.yaml" custom_base_url)
    if [ -z "$host" ]; then
        [[ $url != *://* ]] || scheme=${url%%://*}
    fi
    url=${url#*://}
    url=${url%%/*}
    if [ -z "$host" ]; then
        host=${url%%:*}
        [ -n "$port" ] || [ "$url" = "${url#*:}" ] || port=${url#*:}
    fi
    host=${host:-localhost}
    local socket
    socket=${W4OS_SITE_PHP_SOCKET:-$(php_socket)}
    case $server in
    apache)
        port=${port:-80}
        local listen= php= conf
        [ "$port" = 80 ] || [ "$port" = 443 ] || listen="Listen $port"
        [ -z "$socket" ] || php=$(printf '<FilesMatch "\\.php$">\n        SetHandler "proxy:unix:%s|fcgi://localhost"\n    </FilesMatch>' "$socket")
        conf=$(<"$SHARE/web/apache.conf")
        conf=${conf//\{\{root\}\}/$ROOT}
        conf=${conf//\{\{host\}\}/$host}
        conf=${conf//\{\{port\}\}/$port}
        conf=${conf//\{\{listen\}\}/$listen}
        conf=${conf//\{\{php\}\}/$php}
        if [ -z "$install" ]; then
            printf '%s\n' "$conf"
            return
        fi
        require a2ensite apache2ctl
        # Never a site whose PHP Apache would show as text: PHP-FPM (its pool) or Apache's own PHP module
        [ -n "$socket" ] || apache2ctl -M 2>/dev/null | grep -q php ||
            die "no PHP for Apache: no pool of PHP-FPM (/etc/php/<version>/fpm/pool.d) and no PHP module of Apache: apt install php-fpm, then this command again"
        printf '%s\n' "$conf" >/etc/apache2/sites-available/w4os-site.conf
        local said
        said=$(a2enmod -q rewrite proxy_fcgi 2>&1 && a2ensite -q w4os-site 2>&1) ||
            die "Apache's modules or the site could not be enabled: $said"
        said=$(apache2ctl configtest 2>&1) || {
            a2dissite -q w4os-site >/dev/null 2>&1 || true
            die "Apache refuses the configuration, the site is not enabled (/etc/apache2/sites-available/w4os-site.conf): $said"
        }
        # The address of the site in what it writes (the links of its mails, the pictures), whatever address it is visited at
        local base="http://$host"
        [ "$port" = 80 ] || base="$base:$port"
        yaml_set "$CONFIG/system.yaml" custom_base_url "$base"
        owner
        chown "$OWNER:$GROUP" "$CONFIG/system.yaml" 2>/dev/null || true
        rm -rf "${W4OS_SITE_CACHE:-$ROOT/cache}"/* 2>/dev/null || true
        # Apache takes the site at its reload: it runs, or it is started, never left unsaid
        said=$(systemctl reload apache2 2>&1) || {
            local pid=/run/apache2/apache2.pid
            [ -s "$pid" ] && kill -0 "$(cat "$pid")" 2>/dev/null &&
                die "the site is enabled, but Apache did not reload ($said): reload it (systemctl reload apache2, or apache2ctl graceful without systemd), then this command again"
            die "the site is enabled, but Apache isn't running ($said): start it (systemctl start apache2, or apache2ctl start without systemd), then this command again"
        }
        check_site "$base" "$port" "$host" "$socket"
        ;;
    caddy)
        [ -n "$socket" ] || die "Caddy needs PHP-FPM"
        # A site block of its own (Grav's Caddyfile, made for a site alone, in braces), for the Caddyfile of the machine to import
        # next to its other sites; http:// when the address of the site says so, else Caddy's https
        local address=${host}${port:+:$port}
        [ "$scheme" != http ] || address="http://$address"
        printf '# The w4os site, made by w4os-site web caddy: import this file in the Caddyfile of the machine\n%s {\n' "$address"
        local tab=$'\t'
        sed -e '1,/^localhost$/d' -e "s|^root \* \.|root * $ROOT|" -e "s|php_fastcgi .*|php_fastcgi unix/$socket|" -e "s/^\(.\)/$tab\1/" \
            "$ROOT/webserver-configs/Caddyfile"
        echo '}'
        ;;
    nginx)
        sed "s|root /home/USER/www/html;|root $ROOT;|; s|server_name localhost;|server_name $host;|; s|listen 80;|listen ${port:-80};|; s|unix:/var/run/php/php-fpm.sock|unix:${socket:-/run/php/php-fpm.sock}|" "$ROOT/webserver-configs/nginx.conf"
        ;;
    *) die "w4os-site web apache|caddy|nginx [--host <name>] [--port <port>] [--install]" ;;
    esac
}

# The version of the site: the package that installed it, else its git version in a clone, else the one being worked on
if [[ " $* " == *" --version "* || " $* " == *" -V "* ]]; then
    here=$(cd "$(dirname "$(realpath "$0")")/.." && pwd)
    version=
    if [[ "$here" == /usr/share/w4os-site* ]]; then
        version=$(dpkg-query -W -f='${Version}' w4os-site 2>/dev/null) || version=
    fi
    [[ -n "$version" || ! -e "$here/.git" ]] || version=$(git -C "$here" describe --tags --always --dirty 2>/dev/null) || version=
    [[ -n "$version" || ! -f "$here/.version" ]] || version="$(<"$here/.version") (development)"
    echo "w4os-site ${version:-unknown}"
    exit 0
fi

case ${COMMAND:-} in
setup | status | web)
    # Older bash-tools keep the command in the arguments
    [ "${1:-}" != "$COMMAND" ] || shift
    $COMMAND "$@"
    ;;
*)
    sed -n '3,12p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
