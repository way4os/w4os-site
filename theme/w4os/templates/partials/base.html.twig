{# Quark2's page (1.1.22), its head block copied with one change: the home page is titled "<site> | <slogan>" (the theme's
   slogan in the language of the page, w4os_slogan(); the site alone without one), the other pages "<page> | <site>". Grav's deferred blocks cannot be filtered, so the block is copied: keep it in step with
   Quark2's partials/base.html.twig. #}
{% extends '@quark2/partials/base.html.twig' %}

{% block head %}
    <meta charset="utf-8" />
    {% set slogan = w4os_slogan() %}
    <title>{% if page.home %}{{ site.title|e('html') }}{% if slogan %} | {{ slogan|e('html') }}{% endif %}{% else %}{% if page.title %}{{ page.title|e('html') }} | {% endif %}{{ site.title|e('html') }}{% endif %}</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">

    {% include 'partials/metadata.html.twig' %}

    <link rel="icon" type="{{ favicon_type }}" href="{{ favicon_url ?: url('theme://images/favicon.png') }}" />
    <link rel="canonical" href="{{ page.url(true, true) }}" />

    {# Preload the critical latin subsets so headings + body text render in-font on first paint #}
    <link rel="preload" as="font" type="font/woff2" crossorigin href="{{ url('theme://fonts/inter/inter-latin.woff2') }}" />

    {% if accent_is_hex %}
    {# User-configured accent: tint links, focus ring, and filled UI accents with the chosen hex #}
    <style>
      :root {
        --q2-accent: {{ accent }};
        --q2-accent-contrast: #ffffff;
        --q2-link: {{ accent }};
        --q2-focus-ring: color-mix(in oklab, {{ accent }} 45%, transparent);
      }
      :root[data-theme='dark'] {
        --q2-accent: color-mix(in oklab, {{ accent }} 80%, white 20%);
        --q2-accent-contrast: #ffffff;
        --q2-link: color-mix(in oklab, {{ accent }} 75%, white 25%);
        --q2-focus-ring: color-mix(in oklab, {{ accent }} 45%, transparent);
      }
    </style>
    {% endif %}

    {% if w4os_logo_ratio %}
    {# The ratio of the logo of the top bar (its file, as Grav's media read it) and the site's icon, for css/custom.css #}
    <style>:root { --w4os-logo-ratio: {{ w4os_logo_ratio }}; --w4os-logo-icon: url("{{ w4os_logo_icon|e('css') }}"); }</style>
    {% endif %}

    {# Pre-paint theme bootstrap — blocks FOUC by setting data-theme synchronously #}
    <script>
    (function () {
      try {
        var d = document.documentElement;
        var stored = localStorage.getItem('quark2-theme');
        var pref = stored || d.getAttribute('data-theme-default') || 'auto';
        var isDark = pref === 'dark' || (pref === 'auto' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
        d.setAttribute('data-theme', isDark ? 'dark' : 'light');
        d.setAttribute('data-theme-preference', pref);
        d.classList.toggle('dark', isDark);
      } catch (e) {}
    })();
    </script>
{% endblock head %}

{# The logo of the top bar never distorted: its ratio (Grav's media of the theme's logo, the one Quark2's partial shows) and the
   site's icon (Quark2's favicon) to take its place when the menus leave it too little room (css/custom.css: w4os-logo-fit) #}
{%- set w4os_logo = theme_var('custom_logo') -%}
{%- set w4os_logo_file = (w4os_logo is iterable and w4os_logo|length > 0) ? (w4os_logo|first).name|default(null) : null -%}
{%- set w4os_logo_media = w4os_logo_file ? media_directory('theme://images/logo') : null -%}
{%- set w4os_logo_medium = w4os_logo_media ? w4os_logo_media[w4os_logo_file]|default(null) : null -%}
{%- set w4os_logo_ratio = w4os_logo_medium and w4os_logo_medium.width and w4os_logo_medium.height ? (w4os_logo_medium.width / w4os_logo_medium.height)|round(3) : null -%}
{%- set w4os_favicon = theme_var('custom_favicon') -%}
{%- set w4os_favicon_file = (w4os_favicon is iterable and w4os_favicon|length > 0) ? (w4os_favicon|first).name|default(null) : null -%}
{%- set w4os_logo_icon = w4os_favicon_file ? url('theme://images/favicon/' ~ w4os_favicon_file) : null -%}
{%- set w4os_logo_ratio = w4os_logo_icon ? w4os_logo_ratio : null -%}

{# The width of the page: the theme's for its template (widths), a page of the w4os plugin by its type (w4os-search...) #}
{%- set w4os_widths = config.theme.widths|default({}) -%}
{%- set w4os_key = page.header.w4os|default(false) ? 'w4os-' ~ page.header.w4os : page.template -%}
{%- set w4os_width = w4os_widths[w4os_key]|default(w4os_widths.default|default('standard')) -%}

{# A backdrop behind the pages (the w4os plugin's): the page dressed for it (css/custom.css). Its width: full, sidebars and bleed as
   Quark2's layout-fluid #}
{% block body_classes %}
    {{- parent() }}{{ w4os_logo_ratio ? ' w4os-logo-fit' }}{{ w4os_backdrop|default(false) ? ' w4os-backdrop' }}{{ w4os_width in ['full', 'sidebars', 'bleed'] ? ' layout-fluid' }} w4os-width-{{ w4os_width -}}
{% endblock %}

{# A page edge to edge (bleed: the map), from under the top bar: Quark2's section of the content without its container #}
{% block body %}
    {%- if w4os_width == 'bleed' -%}
        <section id="body-wrapper" class="section">{{ block('content_surround') }}</section>
    {%- else -%}
        {{- parent() -}}
    {%- endif -%}
{% endblock %}
