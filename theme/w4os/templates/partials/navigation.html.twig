{# Quark2's menu of the pages, without the entries the w4os plugin adds to it (log in or my avatar, the search): this theme has them
   in its top bar (partials/theme-toggle.html.twig) #}
{% macro nav_loop(page) %}
  {% import _self as nav %}
  {% for p in page.children.visible %}
    {% if not p.header.w4os %}
    {% set active_page = (p.active or p.activeChild) ? 'active' : '' %}
    {% set has_children = p.children.visible.count > 0 %}
    <li{% if has_children %} class="has-children"{% endif %}>
      <a href="{{ p.url }}" class="{{ active_page }}">
        {% if p.header.menu_icon %}<i class="{{ p.header.menu_icon|fa_icon }}" aria-hidden="true"></i>{% endif %}
        {{ p.menu }}
      </a>
      {% if has_children %}<ul>{{ nav.nav_loop(p) }}</ul>{% endif %}
    </li>
    {% endif %}
  {% endfor %}
{% endmacro %}
{% import _self as nav %}

<ul {{ tree ? 'class="tree navigation"' : 'class="navigation"' }}>
    {{ nav.nav_loop(pages) }}
</ul>
