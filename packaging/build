#!/usr/bin/env bash
# Prepares what the Debian package installs, in build/w4os-site: Grav and its plugins at the versions of dependencies.txt
# (their committed trees, with their composer dependencies), the theme, the defaults of a new site, the installer and the
# web server template. Run by apt-package from the project root.
set -Eeuo pipefail
cd "$(dirname "$0")/.."
root="$PWD"
out="$root/build/w4os-site"
grav="$out/grav"
sources="$root/build/sources"
rm -rf "$out" && mkdir -p "$grav" "$sources"

# shellcheck source=sources.sh
source "$root/packaging/sources.sh"

while read -r path source ref picked; do
    [[ -z ${path:-} || $path == \#* ]] && continue
    # The plugin of another folder (W4OS_PLUGIN: a worktree of a branch, dev/deploy.sh)
    [[ -z ${W4OS_PLUGIN:-} || $source != ../grav-plugin-w4os/* ]] || source="$(cd "$W4OS_PLUGIN" && pwd)/${source#../grav-plugin-w4os/}"
    [[ $source == ../* ]] && source="$root/$source"
    if [[ $source == *.zip ]]; then
        # A release with its vendor folder, the newest of a glob
        zip=$(ls -t $source 2>/dev/null | head -1)
        [ -n "$zip" ] || { echo "No release zip: $source (build it in its project: vendor/bin/build-tools build zip)" >&2; exit 1; }
        rm -rf "$sources/zip" && mkdir -p "$sources/zip" "$grav/$path" && unzip -q "$zip" -d "$sources/zip"
        cp -R "$sources/zip"/*/. "$grav/$path/"
        continue
    fi
    # Some files of a release only, each at its place (from=to)
    if [ -n "${picked:-}" ]; then
        # shellcheck disable=SC2086
        pick "$source" "$ref" "$grav/$path" $picked
        continue
    fi
    extract "$source" "$ref" "$grav/$path"
    # The PHP dependencies of what has some and does not ship them
    if [ -f "$grav/$path/composer.json" ] && [ ! -d "$grav/$path/vendor" ] && grep -q '"require"' "$grav/$path/composer.json"; then
        composer install -q --no-dev --no-interaction --optimize-autoloader -d "$grav/$path"
    fi
done < dependencies.txt

# What the package does not need of Grav
rm -rf "$grav"/{tests,.github,.phan,.oss-scanner,codeception.yml,now.json,.dependencies,CONTRIBUTING.md,CODE_OF_CONDUCT.md}
rm -f "$grav"/user/plugins/*/composer.lock

# The theme of the site, with what dependencies.txt put in it (Font Awesome)
mkdir -p "$grav/user/themes/w4os"
cp -R theme/w4os/. "$grav/user/themes/w4os/"

# A standard Grav site (the zip's tree, the package's seed): the content of a new site (the defaults) in user/, the folders Grav
# writes in its own tree
# shellcheck source=zip.sh
source "$root/packaging/zip.sh"
rm -rf "${grav:?}"/user/{config,pages,accounts,data}
standard_tree "$grav" defaults

# The defaults of a new site, the installer, the web server template
cp -R defaults "$out/defaults"
mkdir -p "$out/bin" "$out/web"
cp bin/w4os-site bin/w4os-site-tree "$out/bin/"
cp web/* "$out/web/"

echo "VERSION_GRAV=$(sed -n 's/^\. .* //p' dependencies.txt)" > "$root/build/packaging.env"
