# Where Grav writes, outside of its code (/usr/share/w4os-site/grav/.env)
GRAV_CACHE_PATH=/var/cache/w4os-site/cache
GRAV_TMP_PATH=/var/cache/w4os-site/tmp
GRAV_LOG_PATH=/var/log/w4os-site
GRAV_BACKUP_PATH=/var/lib/w4os-site/backup
# The sessions of the site in its own folder (see user/config/system.yaml, session.options)
GRAV_CONFIG=true
GRAV_CONFIG__system__session__options__save_path=/var/lib/w4os-site/sessions
